# Copiar a .env.local. Usuarios y bases: psql -U postgres -h localhost -f scripts/setup-local-database.sql
DATABASE_URL=postgres://hospicare_app:CONTRASENA@localhost:5432/hospicare-web
DATABASE_MIGRATION_URL=postgres://hospicare_migrator:CONTRASENA@localhost:5432/hospicare-web
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Correo saliente. Sin estas variables, y solo con BETTER_AUTH_URL en localhost, el correo se escribe en la consola.
RESEND_API_KEY=
MAIL_FROM=
